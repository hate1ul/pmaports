# Co-Maintainer: Viola Guerrera <guerrera.nicola@gmail.com>
maintainer="Pan Ortiz <panjeoc@proton.me>"
_flavor="postmarketos-qcom-sm8150"
pkgname=linux-$_flavor
pkgver=7.1.0
pkgrel=2
pkgdesc="Mainline Kernel fork for SM8150 devices"
arch="aarch64"
_carch="arm64"
url="https://github.com/GengWei1997/linux"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native
	pmb:kconfigcheck-nftables
	"
makedepends="
	bison
	binutils
	kmod
	findutils
	flex
	bc
	build-base
	openssl-dev
	perl
	postmarketos-installkernel
	python3
	"

_tag="raphael-7.1-test"

# Source
source="
	linux-$_tag.tar.gz::https://github.com/GengWei1997/linux/archive/refs/heads/raphael-7.1-test.tar.gz
"
builddir="$srcdir/linux-$_tag"

prepare() {
	default_prepare
}

build() {
	unset LDFLAGS
  make ARCH="$_carch" -j$(nproc) CC="${CC:-gcc}" defconfig sm8150.config efi.config
	make ARCH="$_carch" -j$(nproc) CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$_flavor"
}

package() {
	install -Dm644 "$builddir/arch/$_carch/boot/vmlinuz.efi" \
		"$pkgdir/boot/linux.efi"
	install -Dm644 "$builddir/arch/$_carch/boot/vmlinuz" \
		"$pkgdir/boot/vmlinuz"

	make modules_install dtbs_install \
		ARCH="$_carch" \
		INSTALL_PATH="$pkgdir"/boot/ \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs-tmp

	mkdir -p "$pkgdir"/boot/dtbs/qcom
	cp -r "$pkgdir"/boot/dtbs-tmp/qcom/sm8150* "$pkgdir"/boot/dtbs/qcom
	rm -rf "$pkgdir"/boot/dtbs-tmp
	cp System.map "$pkgdir"/boot/System.map-"$pkgver"-sm8150
	cp .config "$pkgdir"/boot/config-"$pkgver"-sm8150

	rm -f "$pkgdir"/lib/modules/*/build "$pkgdir"/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}

sha512sums="
7d77e5d69a880e112efd4ba6f1e5b44b2114ced44c0671304b1e76a1e38ff1f5fd618d6efec88b08ea7632f1c4c1d04241738bd3cf07ded497b7caa8ec4dca47  linux-raphael-7.1-test.tar.gz
"
