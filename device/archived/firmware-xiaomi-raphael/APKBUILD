# Archived: unmaintained
maintainer=""
pkgname=firmware-xiaomi-raphael
pkgver=20260908
pkgrel=0
pkgdesc="Firmware for Xiaomi Mi 9T Pro / Redmi K20 Pro"
arch="aarch64"
_carch="arm64"

url="https://github.com/hate1ul/kernel-deb/"
license="proprietary"
options="!check !strip !archcheck !tracedeps pmb:cross-native"
_commit="ba18360df9bf9ad9fa5f0e7ecab7f5542453ed55"
source="
	https://github.com/hate1ul/kernel-deb/archive/$_commit.tar.gz
	30-gpu-firmware.files"
builddir="$srcdir/kernel-deb-$_commit"

package() {
	mkdir -p "$pkgdir"/usr/lib/firmware/qcom/sm8150/Xiaomi/raphael/
	install -Dm644 "$srcdir/30-gpu-firmware.files" \
		"$pkgdir/usr/share/mkinitfs/files/30-gpu-firmware.files"

	install -Dm644 "$builddir"/firmware-xiaomi-raphael/usr/lib/firmware/qcom/a6* -t \
		"$pkgdir/usr/lib/firmware/qcom/"

	cp -a "$builddir"/firmware-xiaomi-raphael/usr/lib/firmware/qcom/sm8150/Xiaomi/raphael/. \
    "$pkgdir"/usr/lib/firmware/qcom/sm8150/Xiaomi/raphael/

	install -Dm644 "$builddir"/firmware-xiaomi-raphael/usr/lib/firmware/qca/* -t \
	  "$pkgdir"/usr/lib/firmware/qca/
	install -Dm644 "$builddir"/firmware-xiaomi-raphael/usr/lib/firmware/ath10k/WCN3990/hw1.0/* -t \
	  "$pkgdir"/usr/lib/firmware/ath10k/WCN3990/hw1.0/
	mkdir -p "$pkgdir"/usr/share/qcom/
	cp -a "$builddir"/firmware-xiaomi-raphael/usr/share/qcom/. -t \
	  "$pkgdir"/usr/share/qcom/
}

